{
  "name": "roshooks",
  "version": "0.1.0",
  "description": "React hooks for roslibjs — connect React apps to ROS/ROS2 over rosbridge.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "ros",
    "ros2",
    "roslibjs",
    "rosbridge",
    "react",
    "react-hooks",
    "robotics"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/roshooks.cjs",
  "module": "./dist/roshooks.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/roshooks.js",
      "require": "./dist/roshooks.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "dependencies": {
    "roslib": "^2.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
